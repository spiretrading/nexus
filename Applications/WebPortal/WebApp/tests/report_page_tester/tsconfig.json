{
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react",
    "module": "commonjs",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "outDir": "./application",
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "rootDir": "./source",
    "strictNullChecks": false,
    "target": "es2022",
    "types": [],
    "inlineSources": true
  },
  "include": [
    "./source/**/*.ts",
    "./source/**/*.tsx"
  ]
}
